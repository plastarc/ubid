{
    "name": "plastarc/ubid",
    "description": "Unique Building Identifier (UBID) for PHP: encode, decode and compare the US Department of Energy's open building identifier, with an optional Laravel layer.",
    "keywords": ["ubid", "unique building identifier", "open location code", "plus code", "building", "geocoding", "laravel"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/plastarc/ubid",
    "authors": [
        {"name": "Roger Marsh", "email": "roger@plastarc.com", "homepage": "https://plastarc.com"}
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0"
    },
    "suggest": {
        "illuminate/support": "For the Laravel service provider, HasUbid trait, validation rule, cast and backfill command (^11 || ^12 || ^13)."
    },
    "autoload": {
        "psr-4": {"Plastarc\\Ubid\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Plastarc\\Ubid\\Tests\\": "tests/"}
    },
    "extra": {
        "laravel": {
            "providers": ["Plastarc\\Ubid\\Laravel\\UbidServiceProvider"]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {"pestphp/pest-plugin": true}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
